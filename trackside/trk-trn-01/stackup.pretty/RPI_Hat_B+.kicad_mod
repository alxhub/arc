(footprint "RPI_Hat_B+"
	(version 20240108)
	(generator "stackup")
	(generator_version "8.0")
	(descr "Raspberry Pi HAT board, B+ form factor: the whole outline on Edge.Cuts - 65.0 x 56.5 mm with 3 mm rounded corners and the shaped relief at the connector end - four 3 mm mounting holes at (+/-29, 0) and (+/-29, 49), and the 2x20 P2.54mm header holes in the position the HAT mechanical specification fixes. Not a connector land: it is the board.")

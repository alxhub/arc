(footprint "Arduino_UNO_R3_Socket"
	(version 20240108)
	(generator "stackup")
	(generator_version "8.0")
	(descr "Arduino Uno R3 headers as a host wears them: the four 2.54 mm female sockets - 8-way power, 6-way analog, 8-way and 10-way digital - as 32 plated holes in the same top-view pattern as the shield land, pin 1 at the power header's NC position, the 0.16 in offset between the two digital headers included. Pad n is the Uno R3 symbol's pin n. No outline and no mounting holes: where this lands on an interposer, the board's edge is the stack's business.")
	(tags "arduino uno r3 host socket header")

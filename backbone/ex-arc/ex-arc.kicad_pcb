	(footprint "Arduino_UNO_R3_Pins"
		(layer "F.Cu")
		(uuid "6cdd365c-e7ff-4868-a000-28666f6836a6")
		(at 91.825 109.75)
		(descr "Arduino Uno R3 headers as a shield wears them: four plain male 2.54 mm header strips - 8-way power, 6-way analog, 8-way and 10-way digital - as 32 plated holes in the top-view pattern, pin 1 at the power header's NC position, the 0.16 in offset between the two digital headers included. Pad n is the Uno R3 symbol's pin n. No outline and no mounting holes: a shield's edge and its holes follow the host it sits on.")
